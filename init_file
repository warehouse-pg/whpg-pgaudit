-- start_matchignore
# This pattern is extracted from warehouse-pg/src/test/regress/init_file
m/^(?:HINT|NOTICE):\s+.+\'DISTRIBUTED BY\' clause.*/
m/^NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause */
# WHPG specific warning
m/^WARNING:  creating a table with no columns.*/
-- end_matchignore

-- start_matchsubs
# Replace the changing OID in gp_acquire_sample_rows
m/gp_acquire_sample_rows\(\d+,/
s/gp_acquire_sample_rows\(\d+,/gp_acquire_sample_rows(OID,/

# Normalize EXPLAIN cost/rows/width differences between ORCA and planner
m/Result\s+\(cost=[\d.]+\.\.[\d.]+ rows=\d+ width=\d+\)/
s/Result\s+\(cost=[\d.]+\.\.[\d.]+ rows=\d+ width=\d+\)/Result  (cost=0.00..0.00 rows=1 width=1)/
-- end_matchsubs

-- start_matchignore
# Ignore the optimizer line in EXPLAIN output
m/^\s*Optimizer: GPORCA/
m/^\s*Optimizer: Postgres-based planner/
# WarehousePG does not enforce foreign keys
m/^WARNING:  referential integrity \(FOREIGN KEY\) constraints are not supported in Greenplum Database, will not be enforced/
# A partition takes its distribution key from its parent
m/^NOTICE:  table has parent, setting distribution columns to match parent table/
# Every segment repeats the coordinator's warning
m/^WARNING:  setting an MD5-encrypted password  \(seg\d+ .*/
-- end_matchignore
